# Copy this file to .env and fill in your local values
PORT=4000

# Full connection string style (preferred)
DATABASE_URL=postgresql://javlearn_user:javlearn_pass@localhost:5432/javlearn

# Alternatively, individual params (used only if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=javlearn
PGUSER=javlearn_user
PGPASSWORD=javlearn_pass

# The frontend's origin, allowed to call this API from the browser (CORS).
FRONTEND_URL=http://localhost:5173

# Auth
# Use a long random string in real deployments - this is just a placeholder.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
